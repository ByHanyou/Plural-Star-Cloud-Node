keypair_path: "./node.key"

require_existing_identity: false

network_mode: "public"

psk_path: "./network.psk"

network_id: ""

bootstrap_peers: []

directory_url: ""

api_host: "127.0.0.1"
api_port: 7523
api_token: ""

listen_addrs:
  - "/ip4/0.0.0.0/tcp/4001"
  - "/ip4/0.0.0.0/udp/4001/quic-v1"

announce_addrs: []

relay_enabled: true

max_peers: 200
max_app_connections: 5000

cloud:
  enabled: false

  storage_path: "./cloud"

  media_backend: "local"

  remote_blob_url: ""
  remote_blob_secret: ""

  blob_serve_secret: ""

  s3_endpoint: ""
  s3_region: "us-east-1"
  s3_bucket: ""
  s3_prefix: ""
  s3_access_key: ""
  s3_secret_key: ""

  watermark_percent: 90

  base_quota_mb: 200
  media_quota_mb: 1024
  object_max_mb: 25
  manifest_versions: 30

  inbox_ttl_days: 30
  inbox_quota_mb: 50

  grace_days: 30

  gc_hour_utc: 4

  push_forward_url: ""
  push_forward_token: ""

  push_box_key_path: "./push.key"
